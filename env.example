# ── Server ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Integration Mode ────────────────────────────────────────
# "mock"   → local webcam (no Zoom needed, great for testing)
# "sdk"    → Zoom Meeting SDK for Linux (fastest, direct)
# "recall" → Recall.ai managed bots (easiest cloud option)
INTEGRATION_MODE=mock

# ── Mock mode ────────────────────────────────────────────────
# 0 = webcam, or set a video file path
MOCK_VIDEO_SOURCE=0

# ── Zoom Meeting SDK credentials ────────────────────────────
# Get from: https://marketplace.zoom.us → Build App → Meeting SDK
ZOOM_SDK_KEY=your_sdk_key_here
ZOOM_SDK_SECRET=your_sdk_secret_here

# ── Recall.ai (alternative, cloud-hosted bots) ───────────────
# Get from: https://recall.ai → Dashboard → API Keys
RECALL_API_KEY=your_recall_api_key_here
RECALL_REGION=us-west-2

# ── Model path ───────────────────────────────────────────────
# Copy your trained model here after running train_deepfake_model.py
MODEL_PATH=model\xception_deepfake_image_5o.h5
INTEGRATION_MODE=mock

# ── Detection tuning ─────────────────────────────────────────
ANALYZE_EVERY_N_FRAMES=15    # sample 1 frame every N (2/sec at 30fps)
FAKE_THRESHOLD=0.65          # probability above this triggers fake flag
ALERT_PERSIST_FRAMES=5       # consecutive fakes before alert fires
N_FRAMES=16                  # temporal sequence length for LSTM
